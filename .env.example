# Copy to .env and enter your Stripe sandbox keys locally. Never commit secrets.
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Production only: the signing secret of the separate Connected accounts endpoint.
STRIPE_CONNECT_WEBHOOK_SECRET=
PUBLIC_URL=http://localhost:3001
PORT=3001
# Use this when another Teezy process already runs the local database:
DATABASE_URL=postgres://teezy:teezy@localhost:54329/teezy
# Card checkout captures payment now; sellers receive their ticket subtotal after
# buyer confirmation AND this delay after the event's START time.
PAYOUT_DELAY_HOURS=24
# Deliveries with no reported problem count as received this long after event start.
AUTO_CONFIRM_HOURS=24
ALLOW_LIVE_PAYMENTS=false
# Production email setup (optional for local testing):
# Optional Slack-compatible webhook for server and payment job failures:
ALERT_WEBHOOK_URL=
EMAIL_PROVIDER=dev
EMAIL_FROM=
RESEND_API_KEY=
